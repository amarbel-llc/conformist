// Recognizer grammar for the one flake `outputs` shape conform edits in
// place: an `eachDefaultSystem` call wrapping a `system: let … in { … }`
// lambda. It is run as a second pass over the byte range of the
// `outputs` value located by nix.peg.
//
// The grammar IS the shape gate: an outputs value that does not match
// (flake-parts, a raw forAllSystems/genAttrs flake, a hybrid
// `<modules> // eachDefaultSystem (…)`, an `eachSystem` variant, an
// inline lambda with no `let … in`) makes Match fail, and the caller
// falls back to print-only rather than editing.
//
// Structured nodes are exposed for the splice passes: ArgSet (inject the
// `conformist` argument), LetBlock (inject conformistPkg/eval/impureEval
// before `in`), and ReturnAttrSet (inject formatter/checks/packages/
// devShells before the closing brace). Binding values stay opaque
// (balanced runs), as in nix.peg.
//
// CST mode, -disable-spaces; shared rules are duplicated from nix.peg so
// this grammar is self-contained.

// ── Entry: the outputs value ─────────────────────────────────
// `{ args }: [let <bindings> in] <head> ( system: let <bindings> in { <attrs> } )`
// OuterLet is an optional outer `let … in` block before eachDefaultSystem
// (e.g. hoisting version/commit constants). It is tolerated but not spliced
// into: all wiring lands in the inner per-system let block and return attrset.

File         <- Trivia Outputs Trivia EOF

// ONE sequence with optional parts, rather than an alternative per shape:
// the eng-hybrid `//` merge (conformist#65) and the redundant wrapping paren
// (conformist#101) combine freely, and spelling them out would need eight
// branches.
//
//   OpenParen?/CloseParen?  — a redundant paren around the whole application.
//                             In Nix it is identity, so refusing it was a
//                             parser limitation (conformist#101).
//   LeadMerge?/TrailMerge?  — the eng-hybrid, in BOTH spellings: the merge
//                             attrset may precede (`{ mods } // each (…)`,
//                             e.g. circus) or follow (`each (…) // { mods }`,
//                             e.g. piggy/just-us) the call. dodder and piggy
//                             are paren-wrapped AND merged, so the optionals
//                             must compose.
//
// ArgSet and SystemLambda stay DIRECT children of Outputs — the navigation
// helper descends only through anonymous/Sequence nodes, so hiding them
// behind a named wrapper would silently break the splice offset math. The
// optional pieces below are named rules, but none of them encloses those two.
//
// An unbalanced OpenParen? without its CloseParen? cannot slip through: the
// leftover `)` would then be unconsumed and `File <- … Trivia EOF` fails.
//   AtLead?/AtTrail?        — an at-pattern binding the whole argument
//                             attrset to a name, in either spelling:
//                             `inputs@{ … }:` or `{ … }@inputs:` (just-us).
//                             Another pure spelling difference: the call, the
//                             per-system body and every splice target are
//                             identical (conformist#104).
Outputs      <- AtLead? ArgSet AtTrail? Trivia Colon Trivia OuterLet? LeadMerge? OpenParen? AppHead Trivia ParenOpen Trivia SystemLambda Trivia ParenClose CloseParen? TrailMerge? Trivia
OuterLet     <- LetKw LetBlock InKw Trivia

// The bound name is captured (AtName) so the caller can add it to ArgNames:
// Nix rejects `{ conformist, … }@conformist:` as a duplicate formal, so an
// argument conform would splice must not collide with the at-pattern's name.
AtLead       <- AtName Trivia At Trivia
AtTrail      <- Trivia At Trivia AtName
// Lexical, not `AtName <- Identifier`: a rule that merely forwards to another
// rule need not yield a node of its own, and the caller looks this one up by
// name.
AtName       <- #([a-zA-Z_] [a-zA-Z0-9_'\-]*)
At           <- '@'

OpenParen    <- ParenOpen Trivia
CloseParen   <- Trivia ParenClose

// The merged attrset is parsed as an opaque balanced brace group; the caller
// text-scans it for the attr names it defines. Those names matter: `//` gives
// the RIGHT side precedence, so an output attr present on the merge side would
// silently shadow the same attr spliced into the per-system body. parseOutputs
// records them as MergeExisting so the caller reports a conflict instead of
// writing wiring that never takes effect.
LeadMerge    <- MergeSet Trivia MergeOp Trivia
TrailMerge   <- Trivia MergeOp Trivia MergeSet
MergeSet     <- BraceOpen Inner BraceClose
MergeOp      <- '//'

// The function-argument attrset `{ self, conformist, ... }`. Parsed as a
// balanced brace group; the caller text-scans its inner content for the
// existing argument names and a `...` ellipsis.
ArgSet       <- BraceOpen Inner BraceClose

// A dotted application head ending in `eachDefaultSystem`, e.g.
// `utils.lib.eachDefaultSystem` or `flake-utils.lib.eachDefaultSystem`.
AppHead      <- (Identifier Trivia Dot Trivia)* EachFn
EachFn       <- 'eachDefaultSystem' ![a-zA-Z0-9_]

// `system: let <bindings> in { <attrs> }`. The lambda parameter is a
// bare identifier (eachDefaultSystem passes the system string).
// The per-system body may open SEVERAL sibling `let … in` blocks before the
// returned attrset — a normal way to stage bindings that depend on an earlier
// block (clown). Distinct from a NESTED let, which sits inside a binding value
// and is handled by LetGroup; these are siblings (conformist#105).
//
// Written as an inline group repetition rather than a named LetChain rule on
// purpose: a named wrapper would hide LetBlock and InKw from the navigation
// helper, which descends only through anonymous/Sequence nodes. The caller
// takes the LAST InKw as the splice point (so new bindings can reference
// anything bound earlier) and the UNION of every LetBlock's names (so the
// idempotency sentinel cannot misfire on a flake whose conformist bindings
// live in an earlier block).
SystemLambda <- Identifier Trivia Colon Trivia (LetKw LetBlock InKw Trivia)+ ReturnAttrSet
LetKw        <- 'let' ![a-zA-Z0-9_'\-]
InKw         <- 'in' ![a-zA-Z0-9_'\-]
WithKw       <- 'with' ![a-zA-Z0-9_'\-]
LetBlock     <- Trivia Binding*
ReturnAttrSet <- BraceOpen Trivia Binding* BraceClose

// ── Shared rules (duplicated from nix.peg) ───────────────────

Binding    <- (Inherit / KeyVal) Trivia
Inherit    <- InheritKw Value Semi
KeyVal     <- AttrPath Trivia Equals Trivia Value Semi

AttrPath   <- AttrName (Trivia Dot Trivia AttrName)*
AttrName   <- Identifier / String
Identifier <- #([a-zA-Z_] [a-zA-Z0-9_'\-]*)

// A binding value inside the per-system let block may itself be a
// `let … in …` expression (e.g. `version = let raw = builtins.readFile
// ./version.env; in lib.removePrefix "V=" raw;`). Its inner `;` are
// let-binding separators, not this binding's terminator, so Value must
// treat `let … in` as a balanced construct or it ends the binding at the
// first nested `;` and the whole shape match fails.
// This mirrors nix.peg's LetGroup, which fixed the same defect one level
// up for an OUTER `let … in` before eachDefaultSystem (conformist#81);
// the nested case was never ported into this second-pass grammar.
LetGroup      <- LetKw LetInner InKw
LetInner      <- (LetGroup / Group / String / Comment / LetSemiText)*
// LetSemiText runs up to the `in` that closes the let. `;` is content
// here (it separates let bindings). Like OuterText below, words are
// consumed ATOMICALLY so the LetKw/InKw lookaheads are only tested at a
// token boundary — without that, any identifier ending in "in" would end
// the run mid-word, and `bin` / `writeShellScriptBin` / `plugin` are
// everywhere in real flakes. The lookaheads stay OUTSIDE #(…) because
// langlang v0.0.12 does not support named rule refs inside #(…).
LetSemiText   <- (!(LetKw) !(InKw) LetSemiChunk)+
LetSemiChunk  <- OuterWord / LetSemiChar
LetSemiChar   <- !('{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .

// `with <expr>;` is the OTHER construct whose `;` is not the binding
// terminator (conformist#103). `buildInputs = with pkgs; [ openssl ];` put a
// semicolon before the value proper, so Value ended the binding at
// `with pkgs;` and the leftover `[ … ];` failed the shape match. WithGroup
// consumes the scope expression AND its terminating semicolon, so the `*`
// loop in Value then reads the real value normally.
//
// Nested inside a group this never bit, because Inner treats `;` as content —
// which is exactly why it went unnoticed until posh.
WithGroup     <- WithKw WithScope Semi
WithScope     <- (Group / String / Comment / WithText)*
WithText      <- (!(LetKw) !(WithKw) WithChunk)+
WithChunk     <- OuterWord / WithChar
WithChar      <- !(';' / '{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .

Value      <- (LetGroup / WithGroup / Group / String / Comment / OuterText)*
Inner      <- (Group / String / Comment / InnerText)*
Group      <- BraceOpen Inner BraceClose
            / BracketOpen Inner BracketClose
            / ParenOpen Inner ParenClose
// OuterText stops at a `let` or `with` keyword. The exclusions are required
// even though LetGroup/WithGroup are tried first in Value's alternation:
// without them the greedy `+` swallows straight through a keyword appearing
// after other value content, never handing control back. Words are
// consumed ATOMICALLY (OuterWord) so the lookaheads are only ever
// tested at a token boundary — otherwise an identifier merely ENDING in
// "let" or "with" (`outlet`, `applet`, `runcommandwith`) would falsely stop
// the run and fail the parse. `'` is deliberately excluded from OuterWord so
// the `''` indented-string opener still reaches the String alternative.
OuterText  <- (!(LetKw) !(WithKw) OuterChunk)+
OuterChunk <- OuterWord / OuterChar
OuterWord  <- #([a-zA-Z_] [a-zA-Z0-9_\-]*)
OuterChar  <- !(';' / '{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .
InnerText  <- #((!('{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .)+)

String        <- DString / IString
DString       <- '"' #(DStringPart* '"')
DStringPart   <- Interp / DEscape / DPlain
DPlain        <- #((!('"' / '\\' / '${') .)+)
DEscape       <- #('\\' .)
IString       <- '\'\'' #(IStringPart* '\'\'')
IStringPart   <- Interp / IEscape / IPlain
IEscape       <- #('\'\'' ('$' / '\\' / '\'') )
IPlain        <- #((!('\'\'' / '${') .)+)
Interp        <- '${' Inner '}'

Comment    <- LineComment / BlockComment
LineComment <- #('#' (!Newline .)*)
BlockComment <- #('/*' (!'*/' .)* '*/')

WS         <- #([ \t\r\n]+)
Newline    <- #('\r\n' / '\n')
Trivia     <- (WS / Comment)*

InheritKw    <- 'inherit' ![a-zA-Z0-9_]
Equals       <- '='
Colon        <- ':'
Dot          <- '.'
Semi         <- ';'
BraceOpen    <- '{'
BraceClose   <- '}'
BracketOpen  <- '['
BracketClose <- ']'
ParenOpen    <- '('
ParenClose   <- ')'

EOF        <- !.
