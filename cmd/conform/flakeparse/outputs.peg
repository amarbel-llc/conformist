// Recognizer grammar for the one flake `outputs` shape conform edits in
// place: an `eachDefaultSystem` call wrapping a `system: let … in { … }`
// lambda. It is run as a second pass over the byte range of the
// `outputs` value located by nix.peg.
//
// The grammar IS the shape gate: an outputs value that does not match
// (flake-parts, a raw forAllSystems/genAttrs flake, a hybrid
// `<modules> // eachDefaultSystem (…)`, an `eachSystem` variant, an
// inline lambda with no `let … in`) makes Match fail, and the caller
// falls back to print-only rather than editing.
//
// Structured nodes are exposed for the splice passes: ArgSet (inject the
// `conformist` argument), LetBlock (inject conformistPkg/eval/impureEval
// before `in`), and ReturnAttrSet (inject formatter/checks/packages/
// devShells before the closing brace). Binding values stay opaque
// (balanced runs), as in nix.peg.
//
// CST mode, -disable-spaces; shared rules are duplicated from nix.peg so
// this grammar is self-contained.

// ── Entry: the outputs value ─────────────────────────────────
// `{ args }: [let <bindings> in] <head> ( system: let <bindings> in { <attrs> } )`
// OuterLet is an optional outer `let … in` block before eachDefaultSystem
// (e.g. hoisting version/commit constants). It is tolerated but not spliced
// into: all wiring lands in the inner per-system let block and return attrset.

File         <- Trivia Outputs Trivia EOF
Outputs      <- ArgSet Trivia Colon Trivia OuterLet? AppHead Trivia ParenOpen Trivia SystemLambda Trivia ParenClose Trivia
OuterLet     <- LetKw LetBlock InKw Trivia

// The function-argument attrset `{ self, conformist, ... }`. Parsed as a
// balanced brace group; the caller text-scans its inner content for the
// existing argument names and a `...` ellipsis.
ArgSet       <- BraceOpen Inner BraceClose

// A dotted application head ending in `eachDefaultSystem`, e.g.
// `utils.lib.eachDefaultSystem` or `flake-utils.lib.eachDefaultSystem`.
AppHead      <- (Identifier Trivia Dot Trivia)* EachFn
EachFn       <- 'eachDefaultSystem' ![a-zA-Z0-9_]

// `system: let <bindings> in { <attrs> }`. The lambda parameter is a
// bare identifier (eachDefaultSystem passes the system string).
SystemLambda <- Identifier Trivia Colon Trivia LetKw LetBlock InKw Trivia ReturnAttrSet
LetKw        <- 'let' ![a-zA-Z0-9_'\-]
InKw         <- 'in' ![a-zA-Z0-9_'\-]
LetBlock     <- Trivia Binding*
ReturnAttrSet <- BraceOpen Trivia Binding* BraceClose

// ── Shared rules (duplicated from nix.peg) ───────────────────

Binding    <- (Inherit / KeyVal) Trivia
Inherit    <- InheritKw Value Semi
KeyVal     <- AttrPath Trivia Equals Trivia Value Semi

AttrPath   <- AttrName (Trivia Dot Trivia AttrName)*
AttrName   <- Identifier / String
Identifier <- #([a-zA-Z_] [a-zA-Z0-9_'\-]*)

// A binding value inside the per-system let block may itself be a
// `let … in …` expression (e.g. `version = let raw = builtins.readFile
// ./version.env; in lib.removePrefix "V=" raw;`). Its inner `;` are
// let-binding separators, not this binding's terminator, so Value must
// treat `let … in` as a balanced construct or it ends the binding at the
// first nested `;` and the whole shape match fails.
// This mirrors nix.peg's LetGroup, which fixed the same defect one level
// up for an OUTER `let … in` before eachDefaultSystem (conformist#81);
// the nested case was never ported into this second-pass grammar.
LetGroup      <- LetKw LetInner InKw
LetInner      <- (LetGroup / Group / String / Comment / LetSemiText)*
// LetSemiText runs up to the `in` that closes the let. `;` is content
// here (it separates let bindings). Like OuterText below, words are
// consumed ATOMICALLY so the LetKw/InKw lookaheads are only tested at a
// token boundary — without that, any identifier ending in "in" would end
// the run mid-word, and `bin` / `writeShellScriptBin` / `plugin` are
// everywhere in real flakes. The lookaheads stay OUTSIDE #(…) because
// langlang v0.0.12 does not support named rule refs inside #(…).
LetSemiText   <- (!(LetKw) !(InKw) LetSemiChunk)+
LetSemiChunk  <- OuterWord / LetSemiChar
LetSemiChar   <- !('{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .

Value      <- (LetGroup / Group / String / Comment / OuterText)*
Inner      <- (Group / String / Comment / InnerText)*
Group      <- BraceOpen Inner BraceClose
            / BracketOpen Inner BracketClose
            / ParenOpen Inner ParenClose
// OuterText stops at a `let` keyword. The exclusion is required even
// though LetGroup is tried first in Value's alternation: without it the
// greedy `+` swallows straight through a `let` appearing after other
// value content, never handing control back to LetGroup. Words are
// consumed ATOMICALLY (OuterWord) so the LetKw lookahead is only ever
// tested at a token boundary — otherwise an identifier merely ENDING in
// "let" (`outlet`, `applet`) would falsely stop the run and fail the
// parse. `'` is deliberately excluded from OuterWord so the `''`
// indented-string opener still reaches the String alternative.
OuterText  <- (!(LetKw) OuterChunk)+
OuterChunk <- OuterWord / OuterChar
OuterWord  <- #([a-zA-Z_] [a-zA-Z0-9_\-]*)
OuterChar  <- !(';' / '{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .
InnerText  <- #((!('{' / '}' / '[' / ']' / '(' / ')' / '"' / '\'\'' / '#' / '/*') .)+)

String        <- DString / IString
DString       <- '"' #(DStringPart* '"')
DStringPart   <- Interp / DEscape / DPlain
DPlain        <- #((!('"' / '\\' / '${') .)+)
DEscape       <- #('\\' .)
IString       <- '\'\'' #(IStringPart* '\'\'')
IStringPart   <- Interp / IEscape / IPlain
IEscape       <- #('\'\'' ('$' / '\\' / '\'') )
IPlain        <- #((!('\'\'' / '${') .)+)
Interp        <- '${' Inner '}'

Comment    <- LineComment / BlockComment
LineComment <- #('#' (!Newline .)*)
BlockComment <- #('/*' (!'*/' .)* '*/')

WS         <- #([ \t\r\n]+)
Newline    <- #('\r\n' / '\n')
Trivia     <- (WS / Comment)*

InheritKw    <- 'inherit' ![a-zA-Z0-9_]
Equals       <- '='
Colon        <- ':'
Dot          <- '.'
Semi         <- ';'
BraceOpen    <- '{'
BraceClose   <- '}'
BracketOpen  <- '['
BracketClose <- ']'
ParenOpen    <- '('
ParenClose   <- ')'

EOF        <- !.
