# vim: ft=toml

# Per-repo override of the eng-root pre-merge hook. The eng-root sweatfile lists
# specific recipes (build-home-dry, validate-formatting) tailored to the
# home-manager config repo. conformist is a leaf Go tool, so it follows the
# eng-design_patterns-justfile(7) convention: the pre-merge hook is just `just`
# — the default recipe is the CI-equivalent lane. Here `default: build lint`
# builds the package and runs the conformance checks (the sandboxed file-based
# linters via lint-fmt + the working-tree git-state linters via lint-worktree).
# The [[pre-merge-skills]] (simplify, review, eng:loose-ends) are inherited from
# the eng-root sweatfile and intentionally not redeclared here.

[hooks]
pre-merge = "just"

# Per-commit repair (conformist#39/#40/#47/#51): format the index-staged
# content at authoring time so every commit is conformant in history. This
# names `conformist-pre-commit` — the CONFIG-SPECIFIC, TOOLCHAIN-HERMETIC
# wrapper flake.nix exposes from its own module eval's build.preCommit, on the
# devShell PATH (direnv) under that name — the same self-consumption
# templates/eng prescribes to adopters.
#
# Do NOT use a bare `pre-commit = "conformist --staged --exit-zero-on-fix"`:
# that resolves config and formatters from the ambient PATH. conformist has no
# repo-owned conformist.toml (the config is nix-generated), so in a spinclass
# worktree the bare hook's config discovery refuses eng's config and exits 2 —
# the staged repair silently never runs, which is exactly how a mis-formatted
# file once reached the merge gate. The wrapper bakes in the generated config
# and store-pinned formatters (cf. conformist#51's PATH silent-skip trap).
pre-commit = "conformist-pre-commit"

# Merge-time repair (conformist#54), OPT-IN — uncomment to enable. Runs
# `conformist --commit --amend --exit-zero-on-fix` via the flake's
# `conformist-repair` wrapper (build.repair, same devShell PATH exposure) as a
# spinclass pre-merge repair hook. Left commented, matching the templates/eng
# opt-in stance: with `pre-commit` above active the tree is already conformant
# at merge time, and `--amend` re-signs HEAD. Track conformist#59 for the
# default flipping.
# repair = "conformist-repair"
